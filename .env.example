# Public browser configuration only. These identifiers are not server secrets.
# Demo mode works without this file. For cloud mode copy to .env.local,
# replace the placeholders, then restart Vite or rebuild the static site.
VITE_APPWRITE_ENDPOINT=https://your-appwrite.example/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_FUNCTION_ID=creditgraph-api

# Set secret keys ONLY in the Appwrite Function server environment.
# Never add API keys or MCP credentials to this file or a VITE_* variable.
# See functions/creditgraph/README.md for server-side configuration.
